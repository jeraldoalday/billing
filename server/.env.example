NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-secret"
LOG_LEVEL=info

# Browser origins allowed to call the API (comma-separated). The default is
# the Vite dev server in web/.
CORS_ORIGINS=http://localhost:5173

# Background worker (src/worker.ts)
WORKER_TICK_MS=1000
WORKER_BILLING_INTERVAL_MS=900000
WORKER_DUNNING_INTERVAL_MS=900000
WORKER_WEBHOOK_RETRY_INTERVAL_MS=60000
WORKER_CONCURRENCY=4
