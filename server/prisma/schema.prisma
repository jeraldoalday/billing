generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A billing tenant. All domain data (customers, plans, subscriptions, invoices)
/// is scoped to an Organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Counter behind each Invoice's sequential per-org `number` (see
  // src/services/invoice.service.ts). Incremented inside the same
  // transaction that creates the invoice so numbers are gapless and never
  // reused, even under concurrent invoice generation.
  invoiceSequence Int @default(0)

  users          User[]
  products       Product[]
  plans          Plan[]
  customers      Customer[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  payments       Payment[]
  usageEvents    UsageEvent[]

  dunningCampaigns  DunningCampaign[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]

  coupons           Coupon[]
  couponRedemptions CouponRedemption[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("users")
}

/// A sellable thing (e.g. "Pro Plan API access"). A Product groups one or
/// more Plans, which hold the actual pricing.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plans Plan[]

  @@index([organizationId])
  @@map("products")
}

/// A priced way to buy a Product. Pricing is a discriminated shape keyed by
/// `pricingModel`: FLAT uses `flatAmount`, USAGE uses `usageMetric` +
/// `usageUnitAmount`, TIERED uses `usageMetric` + the related PriceTiers.
/// Amounts are integer minor currency units (e.g. cents) to avoid float math.
///
/// SQLite has no native enum type, so `pricingModel` (PricingModel:
/// FLAT/TIERED/USAGE) and `interval` (BillingInterval: DAY/WEEK/MONTH/YEAR)
/// are plain strings whose values are constrained by Zod — see
/// src/domain/pricing.ts.
model Plan {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  pricingModel    String
  interval        String
  currency        String       @default("usd")
  flatAmount      Int?
  usageMetric     String?
  usageUnitAmount Int?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers         PriceTier[]
  subscriptions Subscription[]

  @@index([organizationId])
  @@index([productId])
  @@map("plans")
}

/// One graduated usage band of a TIERED Plan. `upTo` is the inclusive upper
/// bound of usage quantity billed at `unitAmount` per unit within this band;
/// `null` marks the last, unbounded tier. `order` fixes ascending band order.
model PriceTier {
  id         String @id @default(cuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  order      Int
  upTo       Int?
  unitAmount Int
  flatFee    Int    @default(0)

  @@unique([planId, order])
  @@index([planId])
  @@map("price_tiers")
}

/// A billable party within an Organization. One Customer may hold multiple
/// Subscriptions (e.g. to different products) over time.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  active         Boolean      @default(true)
  // ISO 3166-1 alpha-2 tax jurisdiction, e.g. "US"/"GB"/"DE". Optional since
  // it wasn't required before Day 5; a customer with no country on file is
  // simply taxed at 0 (see src/domain/tax.ts).
  country        String?
  // VAT/GST registration number. Its presence is what makes a customer a
  // business rather than a consumer, which is what the EU reverse-charge
  // rule in src/domain/tax.ts keys off.
  taxId          String?
  // Set for customers who have proven they owe no tax at all (charities,
  // resellers with a valid exemption certificate). Overrides every other
  // rule, including the country rate table.
  taxExempt      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptions  Subscription[]
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  usageEvents    UsageEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

/// A Customer's subscription to a Plan. `status` (SubscriptionStatus:
/// TRIALING/ACTIVE/PAST_DUE/CANCELED) and billing period bounds drive
/// invoice generation (Day 5) and the recurring billing runner (Day 10).
/// SQLite has no native enum type, so `status` is a plain string constrained
/// by Zod — see src/domain/subscription.ts.
///
/// `cancelAt` marks a scheduled end-of-period cancellation requested while
/// the subscription is still TRIALING/ACTIVE; `canceledAt` marks the moment
/// the subscription actually stopped (immediate cancellation, or the day the
/// billing runner processes a scheduled one).
model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan         @relation(fields: [planId], references: [id])
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  cancelAt           DateTime?
  canceledAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  events           SubscriptionEvent[]
  invoices         Invoice[]
  usageEvents      UsageEvent[]
  dunningCampaigns DunningCampaign[]
  couponRedemptions CouponRedemption[]

  @@index([organizationId])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

/// An immutable audit trail entry for a Subscription lifecycle transition.
/// `prorationAmount` (signed, minor currency units) is populated for
/// PLAN_CHANGED events — positive means the customer owes more for the rest
/// of the period, negative means they're owed a credit. Later days (5, 8, 9)
/// can read this history to generate invoice line items and reports without
/// re-deriving it from raw subscription state.
model SubscriptionEvent {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type            String
  previousPlanId  String?
  newPlanId       String?
  prorationAmount Int?
  createdAt       DateTime     @default(now())

  // Set once Day 5's invoicing engine turns this PLAN_CHANGED event's
  // prorationAmount into an InvoiceLineItem, so the same proration is never
  // billed twice across multiple invoice generations for the subscription.
  invoiceLineItem InvoiceLineItem?

  @@index([subscriptionId])
  @@map("subscription_events")
}

/// A generated bill for one Subscription billing period. `number` is a
/// sequential, per-Organization identifier (see Organization.invoiceSequence
/// and src/services/invoice.service.ts), not the database id. `status`
/// (InvoiceStatus: DRAFT/OPEN/PAID/VOID) follows the state machine in
/// src/domain/invoice.ts; SQLite has no native enum type, so it's a plain
/// string constrained by Zod like the other status fields in this schema.
/// `subtotal`/`discountAmount`/`taxAmount`/`total` are integer minor
/// currency units, cached on the invoice (not recomputed from line items on
/// every read) so a paid or voided invoice's amounts stay fixed even if
/// later code changes how totals are derived. They compose as
/// `total = subtotal - discountAmount + taxAmount`: `subtotal` is the sum of
/// the charge line items before any coupon, `discountAmount` is the positive
/// amount a redeemed Coupon took off (also written as a negative DISCOUNT
/// line item so it shows on the rendered invoice), and tax is charged on
/// what's left after the discount, not on the pre-discount subtotal.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String
  status         String
  currency       String
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Int
  discountAmount Int          @default(0)
  taxAmount      Int
  total          Int
  issuedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]
  dunning   DunningCampaign?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

/// One charge or credit on an Invoice. `type` (InvoiceLineItemType:
/// PLAN/PRORATION/USAGE/DISCOUNT) records where the amount came from: PLAN
/// is the plan's recurring price for the period, USAGE is metered
/// consumption, PRORATION is a signed credit/charge carried over from a
/// mid-period plan change (`subscriptionEventId` links back to the
/// originating SubscriptionEvent so it's only ever invoiced once), and
/// DISCOUNT is the coupon the subscription had redeemed at generation time.
/// `amount` is signed (minor currency units) — negative for a proration
/// credit or a discount.
model InvoiceLineItem {
  id                  String             @id @default(cuid())
  invoiceId           String
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type                String
  description         String
  quantity            Int                @default(1)
  unitAmount          Int
  amount              Int
  subscriptionEventId String?            @unique
  subscriptionEvent   SubscriptionEvent? @relation(fields: [subscriptionEventId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A tokenized card on file for a Customer. The raw card number is never
/// stored — only what's needed to display it (`brand`/`last4`/expiry) and
/// what src/lib/paymentGateway.ts needs to simulate an outcome for it. A
/// Customer may have several; at most one is `isDefault` at a time (enforced
/// in src/services/payment.service.ts, not the schema, since SQLite has no
/// partial unique index).
model PaymentMethod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments Payment[]

  @@index([organizationId])
  @@index([customerId])
  @@map("payment_methods")
}

/// One charge attempt sequence against an Invoice (src/services/
/// payment.service.ts#chargeInvoice retries a single logical charge
/// in-process through src/lib/retry.ts, so this row is written once the
/// gateway's outcome is final, not once per HTTP-level retry). `status`
/// (PaymentStatus: SUCCEEDED/FAILED) and `attemptNumber` (how many gateway
/// attempts this charge made before it was recorded) are plain
/// string/int like the other status fields in this schema — see
/// src/domain/payment.ts. `failureCode` mirrors
/// src/lib/paymentGateway.ts's ChargeFailureCode when `status` is FAILED.
model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Int
  currency        String
  status          String
  attemptNumber   Int
  failureCode     String?
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

/// One unit-of-usage recording for metered billing (Day 7). `metric` is a
/// free-form name matched against a USAGE/TIERED Plan's `usageMetric` (see
/// src/domain/pricing.ts) when src/services/invoice.service.ts aggregates
/// usage into an invoice line item at generation time — events whose metric
/// no plan bills for are simply never aggregated. `timestamp` is when the
/// usage occurred (caller-supplied, defaults to ingestion time), distinct
/// from `createdAt` (when the row was written), since usage is often
/// reported after the fact. `idempotencyKey`, when the caller supplies one,
/// makes re-sending the same ingestion request safe: a duplicate key for the
/// same subscription is rejected instead of double-counting usage. SQLite
/// treats each NULL as distinct for a unique index, so subscriptions that
/// never send a key are unaffected.
model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  metric         String
  quantity       Int
  timestamp      DateTime
  idempotencyKey String?
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, idempotencyKey])
  @@index([organizationId])
  @@index([customerId])
  @@index([subscriptionId, metric, timestamp])
  @@map("usage_events")
}

/// A failed-payment recovery campaign for a single OPEN Invoice. Created the
/// first time a charge against that invoice fails (see
/// src/services/payment.service.ts) and drives the retry schedule in
/// src/domain/dunning.ts: retry on day 1, 3 and 7, then give up and cancel
/// the subscription. `invoiceId` is unique so an invoice can only ever be in
/// one campaign — a second failure on an invoice already in dunning
/// re-schedules the existing campaign instead of starting a parallel one.
///
/// SQLite has no native enum type, so `status` (DunningStatus:
/// SCHEDULED/RECOVERED/EXHAUSTED/CANCELED) is a plain string constrained by
/// Zod like the other status fields in this schema.
model DunningCampaign {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId       String       @unique
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status          String
  attemptsMade    Int          @default(0)
  // When the next retry becomes due. Null once the campaign reaches a
  // terminal status, so "due work" is a single indexed query rather than a
  // scan that has to re-derive the schedule for every campaign.
  nextAttemptAt   DateTime?
  startedAt       DateTime     @default(now())
  resolvedAt      DateTime?
  lastFailureCode String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attempts DunningAttempt[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status, nextAttemptAt])
  @@map("dunning_campaigns")
}

/// One retry made by a DunningCampaign. Unlike Payment (which records the
/// final outcome of a logical charge), this is the campaign's own audit
/// trail: what was scheduled, when it actually ran, and how it went.
/// `outcome` (DunningAttemptOutcome: SUCCEEDED/FAILED/SKIPPED) is a plain
/// string; SKIPPED covers an attempt that never reached the gateway (e.g.
/// the customer has no payment method on file), which is a failure of the
/// campaign but not a decline by the processor.
model DunningAttempt {
  id            String          @id @default(cuid())
  campaignId    String
  campaign      DunningCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attemptNumber Int
  scheduledFor  DateTime
  attemptedAt   DateTime        @default(now())
  outcome       String
  failureCode   String?
  paymentId     String?
  createdAt     DateTime        @default(now())

  @@unique([campaignId, attemptNumber])
  @@index([campaignId])
  @@map("dunning_attempts")
}

/// A customer-configured HTTPS destination for outbound domain events.
/// `secret` is generated server-side and only ever returned in full from the
/// create response (see src/services/webhook.service.ts) — every later read
/// returns a masked form, since the secret is what proves a delivery really
/// came from us (HMAC, see src/domain/webhook.ts). `enabledEvents` is a JSON
/// array of event-type patterns (SQLite has no array column); `["*"]` means
/// every event, and `"invoice.*"` matches a whole namespace.
model WebhookEndpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  description    String?
  secret         String
  enabledEvents  String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

/// One event queued for one endpoint. The payload is serialized at emit time
/// and never re-derived, so a redelivery sends byte-identical JSON (and
/// therefore the same signature) as the original attempt, even if the
/// underlying invoice/subscription has changed since. `status`
/// (WebhookDeliveryStatus: PENDING/SUCCEEDED/FAILED) plus `nextAttemptAt`
/// drive the retry sweep in src/services/webhook.service.ts; FAILED is only
/// reached once the attempt budget in src/domain/webhook.ts is exhausted.
model WebhookDelivery {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String
  eventType      String
  payload        String
  status         String
  attemptsMade   Int             @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([endpointId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// A discount an Organization can hand out, redeemed against a
/// Subscription and applied by src/services/invoice.service.ts every time it
/// generates an invoice for that subscription. `type` (CouponType:
/// PERCENT_OFF/AMOUNT_OFF) picks which of `percentOff` (whole percent,
/// 1-100) and `amountOff` (minor currency units, with `currency` naming the
/// unit) carries the value; `duration` (CouponDuration:
/// ONCE/REPEATING/FOREVER) says how many billing periods a single
/// redemption keeps applying for, with `durationInMonths` holding the count
/// for REPEATING. SQLite has no native enum type, so all three are plain
/// strings constrained by Zod — see src/domain/coupon.ts.
///
/// `timesRedeemed` counts redemptions ever created (it is never decremented
/// when one is removed), because `maxRedemptions` caps how many customers
/// may ever take the offer up — not how many hold it right now.
model Coupon {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String?
  type             String
  percentOff       Int?
  amountOff        Int?
  currency         String?
  duration         String
  durationInMonths Int?
  maxRedemptions   Int?
  timesRedeemed    Int          @default(0)
  redeemBy         DateTime?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("coupons")
}

/// One Coupon attached to one Subscription. `periodsApplied` counts the
/// invoices this redemption has already discounted, which is what a
/// ONCE/REPEATING duration is measured against; once the duration is spent
/// the redemption moves to COMPLETED and stops discounting, while REMOVED
/// marks one detached by hand before then. `status` (CouponRedemptionStatus:
/// ACTIVE/COMPLETED/REMOVED) is a plain string like the other status fields
/// in this schema.
///
/// A subscription may hold at most one ACTIVE redemption at a time (enforced
/// in src/services/coupon.service.ts, not the schema, since SQLite has no
/// partial unique index) — stacking discounts would make the order they
/// apply in matter, and nothing in the API expresses that order.
model CouponRedemption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  couponId       String
  coupon         Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         String
  periodsApplied Int          @default(0)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([couponId])
  @@index([subscriptionId, status])
  @@map("coupon_redemptions")
}
