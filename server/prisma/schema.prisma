generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A billing tenant. All domain data (customers, plans, subscriptions, invoices)
/// is scoped to an Organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Counter behind each Invoice's sequential per-org `number` (see
  // src/services/invoice.service.ts). Incremented inside the same
  // transaction that creates the invoice so numbers are gapless and never
  // reused, even under concurrent invoice generation.
  invoiceSequence Int @default(0)

  users         User[]
  products      Product[]
  plans         Plan[]
  customers     Customer[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

/// A sellable thing (e.g. "Pro Plan API access"). A Product groups one or
/// more Plans, which hold the actual pricing.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plans Plan[]

  @@index([organizationId])
  @@map("products")
}

/// A priced way to buy a Product. Pricing is a discriminated shape keyed by
/// `pricingModel`: FLAT uses `flatAmount`, USAGE uses `usageMetric` +
/// `usageUnitAmount`, TIERED uses `usageMetric` + the related PriceTiers.
/// Amounts are integer minor currency units (e.g. cents) to avoid float math.
///
/// SQLite has no native enum type, so `pricingModel` (PricingModel:
/// FLAT/TIERED/USAGE) and `interval` (BillingInterval: DAY/WEEK/MONTH/YEAR)
/// are plain strings whose values are constrained by Zod — see
/// src/domain/pricing.ts.
model Plan {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  pricingModel    String
  interval        String
  currency        String       @default("usd")
  flatAmount      Int?
  usageMetric     String?
  usageUnitAmount Int?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tiers         PriceTier[]
  subscriptions Subscription[]

  @@index([organizationId])
  @@index([productId])
  @@map("plans")
}

/// One graduated usage band of a TIERED Plan. `upTo` is the inclusive upper
/// bound of usage quantity billed at `unitAmount` per unit within this band;
/// `null` marks the last, unbounded tier. `order` fixes ascending band order.
model PriceTier {
  id         String @id @default(cuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  order      Int
  upTo       Int?
  unitAmount Int
  flatFee    Int    @default(0)

  @@unique([planId, order])
  @@index([planId])
  @@map("price_tiers")
}

/// A billable party within an Organization. One Customer may hold multiple
/// Subscriptions (e.g. to different products) over time.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  active         Boolean      @default(true)
  // ISO 3166-1 alpha-2 tax jurisdiction, e.g. "US"/"GB"/"DE". Optional since
  // it wasn't required before Day 5; a customer with no country on file is
  // simply taxed at 0 (see src/domain/tax.ts).
  country        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

/// A Customer's subscription to a Plan. `status` (SubscriptionStatus:
/// TRIALING/ACTIVE/PAST_DUE/CANCELED) and billing period bounds drive
/// invoice generation (Day 5) and the recurring billing runner (Day 10).
/// SQLite has no native enum type, so `status` is a plain string constrained
/// by Zod — see src/domain/subscription.ts.
///
/// `cancelAt` marks a scheduled end-of-period cancellation requested while
/// the subscription is still TRIALING/ACTIVE; `canceledAt` marks the moment
/// the subscription actually stopped (immediate cancellation, or the day the
/// billing runner processes a scheduled one).
model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan         @relation(fields: [planId], references: [id])
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd           DateTime?
  cancelAt           DateTime?
  canceledAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  events   SubscriptionEvent[]
  invoices Invoice[]

  @@index([organizationId])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

/// An immutable audit trail entry for a Subscription lifecycle transition.
/// `prorationAmount` (signed, minor currency units) is populated for
/// PLAN_CHANGED events — positive means the customer owes more for the rest
/// of the period, negative means they're owed a credit. Later days (5, 8, 9)
/// can read this history to generate invoice line items and reports without
/// re-deriving it from raw subscription state.
model SubscriptionEvent {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type            String
  previousPlanId  String?
  newPlanId       String?
  prorationAmount Int?
  createdAt       DateTime     @default(now())

  // Set once Day 5's invoicing engine turns this PLAN_CHANGED event's
  // prorationAmount into an InvoiceLineItem, so the same proration is never
  // billed twice across multiple invoice generations for the subscription.
  invoiceLineItem InvoiceLineItem?

  @@index([subscriptionId])
  @@map("subscription_events")
}

/// A generated bill for one Subscription billing period. `number` is a
/// sequential, per-Organization identifier (see Organization.invoiceSequence
/// and src/services/invoice.service.ts), not the database id. `status`
/// (InvoiceStatus: DRAFT/OPEN/PAID/VOID) follows the state machine in
/// src/domain/invoice.ts; SQLite has no native enum type, so it's a plain
/// string constrained by Zod like the other status fields in this schema.
/// `subtotal`/`taxAmount`/`total` are integer minor currency units, cached
/// on the invoice (not recomputed from line items on every read) so a paid
/// or voided invoice's amounts stay fixed even if later code changes how
/// totals are derived.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String
  status         String
  currency       String
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Int
  taxAmount      Int
  total          Int
  issuedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lineItems InvoiceLineItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

/// One charge or credit on an Invoice. `type` (InvoiceLineItemType:
/// PLAN/PRORATION) records where the amount came from: PLAN is the plan's
/// recurring price for the period, PRORATION is a signed credit/charge
/// carried over from a mid-period plan change (`subscriptionEventId` links
/// back to the originating SubscriptionEvent so it's only ever invoiced
/// once). `amount` is signed (minor currency units) — negative for a
/// proration credit.
model InvoiceLineItem {
  id                  String            @id @default(cuid())
  invoiceId           String
  invoice             Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type                String
  description         String
  quantity            Int               @default(1)
  unitAmount          Int
  amount              Int
  subscriptionEventId String?           @unique
  subscriptionEvent   SubscriptionEvent? @relation(fields: [subscriptionEventId], references: [id])
  createdAt           DateTime          @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}
